# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Generated pact files (published artefacts, not source)
*/build/pacts/

# Tool scratch dirs
.pi/

# Eclipse/Buildship metadata written by the Java language server (jdtls)
.classpath
.project
.settings/
bin/

# The wrapper jar must ship with the repo: a fresh checkout has no gradle installed.
!gradle/wrapper/gradle-wrapper.jar
